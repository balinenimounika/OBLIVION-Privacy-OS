# ==============================================================================
# OBLIVION – Environment Configuration Template (.env.example)
# Platform: OBLIVION – The Internet's Forget Button
# Note: Copy this file to .env and configure with your local environment values.
# NEVER commit or expose the real .env file or production secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV="development"

# Server listener port
PORT="5000"

# ------------------------------------------------------------------------------
# 2. Database Connection & Pooling (PostgreSQL 18.6 + Prisma ORM)
# ------------------------------------------------------------------------------
# PostgreSQL connection string URL
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=[SCHEMA]&sslmode=[MODE]
# Local Windows development example:
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/oblivion_db?schema=public"

# Database Connection Pool Sizing
DB_POOL_MIN="2"
DB_POOL_MAX="10"
DB_TIMEOUT_MS="30000"

# ------------------------------------------------------------------------------
# 3. Authentication & Cryptography (JWT)
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing and verifying HS256 JSON Web Tokens.
# Must be a cryptographically strong string of at least 16 characters (32+ chars recommended in production).
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters_for_production"

# Access token lifetime string (e.g. '15m', '1h', '7d')
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. "http://localhost:3000,http://localhost:5173").
# In production, set this explicitly to your production web app domain (e.g. "https://app.oblivion.privacy").
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Resend Transactional Email Notification System
# ------------------------------------------------------------------------------
# Official Resend API Key from https://resend.com/api-keys
# Format: re_[a-zA-Z0-9]+
RESEND_API_KEY=""

# Configurable Sender Email Address:
# - Development / Sandbox: "onboarding@resend.dev" (allows delivery to Resend account owner or test sink)
# - Production: "notifications@yourdomain.com" or "privacy@yourdomain.com"
# IMPORTANT: In production, you must verify your custom domain in Resend (https://resend.com/domains)
# by adding the DKIM (CNAME), SPF (MX/TXT), and DMARC (TXT) records supplied by Resend to your DNS provider.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Sender Display Name presented to recipient mail clients (e.g. "OBLIVION Privacy OS")
RESEND_FROM_NAME="OBLIVION Privacy OS"

# Webhook signing secret from Resend webhook settings (svix secret starting with whsec_)
# Required in production to cryptographically verify delivery events (delivered, bounced, complained)
RESEND_WEBHOOK_SECRET=""

# Public application base URL used for clickable reminder links in emails
APP_BASE_URL="http://localhost:3000"

# Master switch to enable or disable transactional email notifications
EMAIL_NOTIFICATIONS_ENABLED="true"

# Resend development test mode (redirects all outgoing emails to RESEND_TEST_TO)
# Set to 'true' in development to test templates with delivered@resend.dev without a custom domain.
# In production, this setting is automatically ignored and real user recipients are always used.
EMAIL_TEST_MODE="false"

# Test recipient address for Resend test mode (default: delivered@resend.dev)
RESEND_TEST_TO="delivered@resend.dev"

# Comma-separated list of explicitly allowlisted developer emails for live inbox testing during development.
# Any recipient in this list will receive the email directly in their real inbox even if EMAIL_TEST_MODE=true.
# Non-allowlisted recipients will continue to be safely redirected to RESEND_TEST_TO.
# In production, this setting is ignored and emails are always sent directly to verified registered users.
ALLOWED_TEST_EMAILS="developer@example.com"
